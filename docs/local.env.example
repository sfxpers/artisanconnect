# Local development secrets. Copy to `.env` at the repo root and fill in values.
# Never commit `.env`. Void reads only that file (no root `.env.example`, no Wrangler `.dev.vars`).

# Signs session cookies. Any long random string; `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Cloudflare's Turnstile test secret, which passes every check.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Signs the fake payment adapter's webhooks. Any long random string; `openssl rand -base64 32`.
PAYMENTS_WEBHOOK_SECRET=
