{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artisanconnect",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Custom domains: replace the pattern with your hostname, then uncomment.
  // "routes": [
  //   { "pattern": "artisanconnect.example.com", "custom_domain": true },
  // ],
  // Workers Logs, with Issues grouping every failure and logged error (ADR 0017).
  "observability": {
    "enabled": true,
    "issues": { "enabled": true },
  },
  // So an Issue's stack names the source lines, not the bundle's.
  "upload_source_maps": true,
  // Every clock is a row with a due time; this cron runs the due ones (ADR 0017),
  // and the daily Payout run once its time of day comes.
  "triggers": {
    "crons": ["* * * * *"],
  },

  // The top level is local. Staging and production below repeat every binding
  // with their own D1, R2, and secrets; bindings are not inherited.
  // MAIL_FROM: replace with an address on the domain verified for Email Sending.
  // APP_URL: the web app's origin, which links in emails point to.
  // PAYOUT_RUN_TIME: when the daily Payout run goes, as a South African time of day.
  // TURNSTILE_SITE_KEY: locally, Cloudflare's test key that always passes.
  "vars": {
    "ENVIRONMENT": "local",
    "MAIL_FROM": "ArtisanConnect <no-reply@example.com>",
    "APP_URL": "http://localhost:3000",
    "PAYOUT_RUN_TIME": "09:00",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY", "PAYMENTS_WEBHOOK_SECRET"],
  },
  // Workers AI is always remote; saying so quiets Wrangler's warning locally.
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  // Cloudflare Images draws each photo again before it is stored (ADR 0017).
  "images": {
    "binding": "IMAGES",
  },
  // Stops a flood of sign-ups, sign-ins, and code requests or entries from one
  // network before the domain module (ADR 0017). Locally loose, for the smoke
  // tests' many sign-ins; each environment counts in its own namespace.
  "ratelimits": [
    {
      "name": "IP_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 },
    },
  ],
  // D1: omit database_id so Wrangler can auto-provision on first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artisanconnect",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "artisanconnect",
    },
  ],
  // Cloudflare Email Sending, outbound only.
  "send_email": [
    {
      "name": "SEND_EMAIL",
    },
  ],

  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging",
        "MAIL_FROM": "ArtisanConnect <no-reply@artisanconnect.co.za>",
        "APP_URL": "https://artisanconnect-staging.weathered-shadow-5138.workers.dev",
        "PAYOUT_RUN_TIME": "09:00",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFU7PtdnwZ5hBIB7",
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY", "PAYMENTS_WEBHOOK_SECRET"],
      },
      "ai": {
        "binding": "AI",
      },
      "images": {
        "binding": "IMAGES",
      },
      "ratelimits": [
        {
          "name": "IP_LIMIT",
          "namespace_id": "1002",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "artisanconnect-staging",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "artisanconnect-staging",
        },
      ],
      "send_email": [
        {
          "name": "SEND_EMAIL",
        },
      ],
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "MAIL_FROM": "ArtisanConnect <no-reply@example.com>",
        "APP_URL": "https://artisanconnect.example.com",
        "PAYOUT_RUN_TIME": "09:00",
        "TURNSTILE_SITE_KEY": "replace-with-the-production-turnstile-site-key",
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY", "PAYMENTS_WEBHOOK_SECRET"],
      },
      "ai": {
        "binding": "AI",
      },
      "images": {
        "binding": "IMAGES",
      },
      "ratelimits": [
        {
          "name": "IP_LIMIT",
          "namespace_id": "1003",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "artisanconnect-production",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "artisanconnect-production",
        },
      ],
      "send_email": [
        {
          "name": "SEND_EMAIL",
        },
      ],
    },
  },
}
