{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artisanconnect",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": true,
  // Custom domains: replace the pattern with your hostname, then uncomment.
  // "routes": [
  //   { "pattern": "artisanconnect.example.com", "custom_domain": true },
  // ],
  // Workers Logs. Errors also go to Sentry (SENTRY_DSN).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  // Every clock is a row with a due time; this cron runs the due ones (ADR 0017),
  // and the daily Payout run once its time of day comes.
  "triggers": {
    "crons": ["* * * * *"],
  },

  // The top level is local. Staging and production below repeat every binding
  // with their own D1, R2, and secrets; bindings are not inherited.
  // MAIL_FROM: replace with an address on the domain verified for Email Sending.
  // APP_URL: the web app's origin, which links in emails point to.
  // PAYOUT_RUN_TIME: when the daily Payout run goes, as a South African time of day.
  // TURNSTILE_SITE_KEY: locally, Cloudflare's test key that always passes.
  "vars": {
    "APP_NAME": "artisanconnect",
    "ENVIRONMENT": "local",
    "MAIL_FROM": "ArtisanConnect <no-reply@example.com>",
    "APP_URL": "http://localhost:3000",
    "PAYOUT_RUN_TIME": "10:00",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
  },
  "secrets": {
    "required": ["SENTRY_DSN", "BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY"],
  },
  // Workers Assets: the Vite plugin injects the client build directory.
  "assets": {
    "binding": "ASSETS",
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  // D1: omit database_id so Wrangler can auto-provision on first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artisanconnect",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "artisanconnect",
    },
  ],
  // Cloudflare Email Sending, outbound only.
  "send_email": [
    {
      "name": "SEND_EMAIL",
    },
  ],

  "env": {
    "staging": {
      "vars": {
        "APP_NAME": "artisanconnect",
        "ENVIRONMENT": "staging",
        "MAIL_FROM": "ArtisanConnect <no-reply@example.com>",
        "APP_URL": "https://staging.artisanconnect.example.com",
        "PAYOUT_RUN_TIME": "10:00",
        "TURNSTILE_SITE_KEY": "replace-with-the-staging-turnstile-site-key",
      },
      "secrets": {
        "required": ["SENTRY_DSN", "BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY"],
      },
      "assets": {
        "binding": "ASSETS",
      },
      "ai": {
        "binding": "AI",
        "remote": true,
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "artisanconnect-staging",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "artisanconnect-staging",
        },
      ],
      "send_email": [
        {
          "name": "SEND_EMAIL",
        },
      ],
    },
    "production": {
      "vars": {
        "APP_NAME": "artisanconnect",
        "ENVIRONMENT": "production",
        "MAIL_FROM": "ArtisanConnect <no-reply@example.com>",
        "APP_URL": "https://artisanconnect.example.com",
        "PAYOUT_RUN_TIME": "10:00",
        "TURNSTILE_SITE_KEY": "replace-with-the-production-turnstile-site-key",
      },
      "secrets": {
        "required": ["SENTRY_DSN", "BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY"],
      },
      "assets": {
        "binding": "ASSETS",
      },
      "ai": {
        "binding": "AI",
        "remote": true,
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "artisanconnect-production",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "artisanconnect-production",
        },
      ],
      "send_email": [
        {
          "name": "SEND_EMAIL",
        },
      ],
    },
  },
}
