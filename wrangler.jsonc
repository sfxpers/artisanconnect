{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artisanconnect",
  "account_id": "ab816378ce175deba8768e44d4c9478b",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "enabled": true,
    "issues": { "enabled": true },
  },
  // An Issue's stack names the source lines, not the bundle's.
  "upload_source_maps": true,
  // Runs each clock once it is due.
  "triggers": {
    "crons": ["* * * * *"],
  },

  // Bindings are not inherited. The local Turnstile key always passes.
  // PAYOUT_RUN_TIME is a South African time of day.
  "vars": {
    "ENVIRONMENT": "local",
    "MAIL_FROM": "ArtisanConnect <no-reply@example.com>",
    "APP_URL": "http://localhost:3000",
    "PAYOUT_RUN_TIME": "09:00",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY", "PAYMENTS_WEBHOOK_SECRET"],
  },
  // Quiets Wrangler's warning. Workers AI has no local simulation.
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "images": {
    "binding": "IMAGES",
  },
  // Loose locally: the smoke tests sign in many times. Each environment has its own namespace.
  "ratelimits": [
    {
      "name": "IP_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artisanconnect",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "artisanconnect",
    },
  ],
  "send_email": [
    {
      "name": "SEND_EMAIL",
    },
  ],

  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging",
        "MAIL_FROM": "ArtisanConnect <no-reply@artisanconnect.co.za>",
        "APP_URL": "https://artisanconnect-staging.weathered-shadow-5138.workers.dev",
        "PAYOUT_RUN_TIME": "09:00",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFU7PtdnwZ5hBIB7",
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY", "PAYMENTS_WEBHOOK_SECRET"],
      },
      "ai": {
        "binding": "AI",
      },
      "images": {
        "binding": "IMAGES",
      },
      "ratelimits": [
        {
          "name": "IP_LIMIT",
          "namespace_id": "1002",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "artisanconnect-staging",
          "database_id": "658d50d5-6b9f-4d92-afe8-6e1e80570c82",
          // admin:setup runs beside the Worker and reads this D1.
          "remote": true,
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "artisanconnect-staging",
        },
      ],
      "send_email": [
        {
          "name": "SEND_EMAIL",
        },
      ],
    },
    "production": {
      // Apex custom domain: Cloudflare makes the DNS record and certificate.
      "routes": [{ "pattern": "artisanconnect.co.za", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "MAIL_FROM": "ArtisanConnect <no-reply@artisanconnect.co.za>",
        "APP_URL": "https://artisanconnect.co.za",
        "PAYOUT_RUN_TIME": "09:00",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFWwjRc9qeMKE8Jh",
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY", "PAYMENTS_WEBHOOK_SECRET"],
      },
      "ai": {
        "binding": "AI",
      },
      "images": {
        "binding": "IMAGES",
      },
      "ratelimits": [
        {
          "name": "IP_LIMIT",
          "namespace_id": "1003",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "artisanconnect-production",
          "database_id": "3874eb0d-f6f5-4d2d-992e-96381a3d21e6",
          // admin:setup runs beside the Worker and reads this D1.
          "remote": true,
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "artisanconnect-production",
        },
      ],
      "send_email": [
        {
          "name": "SEND_EMAIL",
        },
      ],
    },
  },
}
