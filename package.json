{
  "name": "artisanconnect",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:staging": "wrangler d1 migrations apply DB --config wrangler.jsonc --env staging --remote && CLOUDFLARE_ENV=staging vite build && wrangler deploy",
    "deploy:production": "wrangler d1 migrations apply DB --config wrangler.jsonc --env production --remote && CLOUDFLARE_ENV=production vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "oxlint .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "postinstall": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@sentry/cloudflare": "^11.4.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.53",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "jsonc-parser": "^3.3.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.9.1",
      "onFail": "ignore"
    }
  }
}
