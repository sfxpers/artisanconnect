{
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", ".wrangler", ".tanstack"],
  "compilerOptions": {
    "jsx": "react-jsx",
    // Vite compiles each file alone, so nothing may need the rest of the program.
    "isolatedModules": true,
    // The Workers types and the DOM's declare the same globals differently;
    // checking library files fails on every clash.
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
