{
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", ".wrangler", ".output", ".tanstack"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
