{
  "extends": "./.void/tsconfig.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", ".wrangler", ".tanstack"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["void/env"]
  }
}
